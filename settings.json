{
  // Themes I like:
  // - Bearded Theme Black & Gold
  // - Bearded Theme Black & Ruby
  // - Bearded Theme Milkshake Mint (light theme)
  "workbench.colorTheme": "Bearded Theme Black & Gold",
  "workbench.iconTheme": "bearded-icons",
  "python.languageServer": "Jedi",

  // Fallback themes when semantic tokens aren't available.
  "editor.tokenColorCustomizations": {
    "[Bearded Theme Black & Gold]": {
      "comments": {
        "foreground": "#777",
        "fontStyle": "italic"
      },
      "functions": {
        "foreground": "#1e7",
        "fontStyle": ""
      },
      "keywords": {
        "foreground": "#f90",
        "fontStyle": ""
      },
      "numbers": {
        "foreground": "#b86",
        "fontStyle": ""
      },
      "strings": {
        "foreground": "#ff0",
        "fontStyle": ""
      },
      "types": {
        "foreground": "#96f",
        "fontStyle": ""
      },
      "variables": {
        "foreground": "#9ef",
        "fontStyle": ""
      },
      "textMateRules": [
        {
          "scope": ["comment"],
          "settings": {
            "foreground": "#777",
            "fontStyle": "italic"
          }
        },
        {
          "scope": ["entity.name.function"],
          "settings": {
            "foreground": "#1e7",
            "fontStyle": ""
          }
        },
        {
          "scope": [
            "string",
            "string.quoted.single",
            "punctuation.definition.string.begin",
            "punctuation.definition.string.end",
            "string.quoted.single.python punctuation.definition.string.begin.python",
            "string.quoted.single.python punctuation.definition.string.end.python"
          ],
          "settings": {
            "foreground": "#ff0",
            "fontStyle": ""
          }
        },
        {
          "scope": ["keyword", "keyword.control"],
          "settings": {
            "foreground": "#f90",
            "fontStyle": ""
          }
        }
      ]
    }
  },

  // Semantic theme settings.
  "editor.semanticTokenColorCustomizations": {
    "[Bearded Theme Black & Gold]": {
      "enabled": true,
      "rules": {
        "comment": {
          "foreground": "#777",
          "fontStyle": "italic"
        },
        "class": {
          "foreground": "#96f",
          "fontStyle": ""
        },
        "enum": {
          "foreground": "#96f",
          "fontStyle": ""
        },
        "enumMember": {
          "foreground": "#b86",
          "fontStyle": "italic"
        },
        "function": {
          "foreground": "#1e7",
          "fontStyle": ""
        },
        "deriveHelper": {
          "foreground": "#1e7",
          "fontStyle": ""
        },
        "keyword": {
          "foreground": "#f90",
          "fontStyle": ""
        },
        "macro": {
          "foreground": "#f0f",
          "fontStyle": ""
        },
        "method": {
          "foreground": "#1e7",
          "fontStyle": "italic"
        },
        "namespace": {
          "foreground": "#aaa",
          "fontStyle": ""
        },
        "number": {
          "foreground": "#b86",
          "fontStyle": ""
        },
        "parameter": {
          "foreground": "#d6c",
          "fontStyle": "italic"
        },
        "property": {
          "foreground": "#4df",
          "fontStyle": "italic"
        },
        "string": {
          "foreground": "#ff0",
          "fontStyle": ""
        },
        "struct": {
          "foreground": "#96f",
          "fontStyle": ""
        },
        "type": {
          "foreground": "#96f",
          "fontStyle": ""
        },
        "typeParameter": {
          "foreground": "#96f",
          "fontStyle": "italic"
        },
        "variable": {
          "foreground": "#9ef",
          "fontStyle": ""
        }
      }
    }
  },

  "[rust]": {
    // cargo fmt ideal wifth is 80
    "editor.rulers": [80]
  },
  "[python]": {
    // ruff format max width is 88
    "editor.rulers": [88]
  },
  "[markdown]": {
    // I like a max width of 100
    "editor.rulers": [100]
  },
  "[jsonc]": {
    // I like a max width of 100
    "editor.rulers": [100],
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Disable inlay hints for rust.
  // - Rust is smart enough to figure it out.
  // - Hover to figure it out
  // - Disrespects the line width
  "rust-analyzer.inlayHints.typeHints.enable": false,
  // I'm typically opening another folder for reference. Do not replace the current workspace.
  "window.openFoldersInNewWindow": "on",
  // I often have a reference folder last open, not my main folder. Allow me to select from recents
  // whenever I start VSCodium.
  "window.restoreWindows": "none"
}
